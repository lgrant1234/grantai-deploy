[Unit]
Description=GrantAi system of record for AI agents
Documentation=https://solonai.com/grantai
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grantai
Group=grantai
WorkingDirectory=/opt/grantai
EnvironmentFile=/opt/grantai/etc/grantai.env
ExecStart=/opt/grantai/current/bin/grantai-mcp --http --bind 0.0.0.0 --port ${GRANTAI_HTTP_PORT} --cert /opt/grantai/etc/tls.crt --key /opt/grantai/etc/tls.key

# Graceful stop: the server closes its listeners on SIGTERM (fixed 2026-10-07).
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
# Licence and store refusals are configuration errors; do not loop on them.
RestartPreventExitStatus=2 3 4 5 6 7 11

# Hardening. The engine writes only under data/, home/ and var/.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/grantai/data /opt/grantai/home /opt/grantai/var
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=grantai

[Install]
WantedBy=multi-user.target
